# Function to generate commit message using LLM
generate_commit() {
    git add .
    # Get the staged changes
    DIFF=$(git diff --cached)
    
    if [ -z "$DIFF" ]; then
        echo "No staged changes found. Please stage your changes first using 'git add'"
        return 1
    fi
    
    #echo "$DIFF" | python3 -c "import sys; print(sys.stdin.read(8000))"
    # Generate commit message using LLM
    COMMIT_MSG=$(echo "$DIFF" |llm -m nemotron -x "Generate a concise commit message (first line) and detailed description (separated by blank line) based on these changes. Follow conventional commits format. Git diff: ")
    
    if [ -z "$COMMIT_MSG" ]; then
        echo "Failed to generate commit message"
        return 1
    fi
    
    # Commit with the generated message
    git commit -m "$COMMIT_MSG"
}

generate_commit
# Alias for the function
#alias gac='generate_commit'